# YANDEX_METRIKA_ID=110624464

# Базовый URL приложения (canonical, sitemap, OAuth redirect).
# На проде укажите публичный домен, например: https://example.com
# Если не задан или указан localhost — на проде URL определяется из запроса (X-Forwarded-Proto/Host).
APP_URL=http://localhost:8080

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Яндекс OAuth — https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# VK ID — https://id.vk.com/about/business/go/docs/ru/vkid/latest/vk-id/connection/create-application
VK_CLIENT_ID=
VK_CLIENT_SECRET=
